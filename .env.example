# Environment Variables for Ndotoni Surveys Frontend
# Copy this file to .env.local and fill in real values — do not commit
# real credentials here.
#
# This app has NO backend of its own — it points at the SAME Cognito user
# pool + AppSync API as the main ndotoniWeb app. Use the WEB app client
# (not the legacy client) — it's the one with Google/Facebook/Apple
# identity providers enabled.
#
# To pull the current values for a given stage, from ndotoniBackend/packages/cdk:
#   aws cloudformation describe-stacks --stack-name RentalApp-Auth-<stage> \
#     --region us-west-2 --profile <stage> --query 'Stacks[0].Outputs'
#   aws cloudformation describe-stacks --stack-name RentalApp-Service-<stage> \
#     --region us-west-2 --profile <stage> --query 'Stacks[0].Outputs'

# AWS Cognito Configuration
NEXT_PUBLIC_USER_POOL_ID=REPLACE_WITH_USER_POOL_ID
NEXT_PUBLIC_USER_POOL_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID

# Cognito OAuth Configuration
NEXT_PUBLIC_COGNITO_DOMAIN=REPLACE_WITH_COGNITO_DOMAIN
NEXT_PUBLIC_REDIRECT_SIGN_IN=http://localhost:3001/auth/callback
NEXT_PUBLIC_REDIRECT_SIGN_OUT=http://localhost:3001

# GraphQL API Configuration
NEXT_PUBLIC_GRAPHQL_ENDPOINT=REPLACE_WITH_GRAPHQL_ENDPOINT
NEXT_PUBLIC_GRAPHQL_REGION=us-west-2
NEXT_PUBLIC_API_KEY=REPLACE_WITH_GRAPHQL_API_KEY
