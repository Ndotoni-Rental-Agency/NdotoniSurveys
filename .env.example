# Environment Variables for Ndotoni Surveys Frontend
# Copy this file to .env.local and fill in your values.
# These point at the SAME Cognito user pool + AppSync API as the main
# ndotoni-web app — surveys reuses that backend, it does not have its own.

# AWS Cognito Configuration
NEXT_PUBLIC_USER_POOL_ID=us-west-2_N7XRQtTla
NEXT_PUBLIC_USER_POOL_CLIENT_ID=3v5doqrrc3i1e5trkg82mkmlrm

# Cognito OAuth Configuration
NEXT_PUBLIC_COGNITO_DOMAIN=rental-app-beta-977099001723.auth.us-west-2.amazoncognito.com
NEXT_PUBLIC_REDIRECT_SIGN_IN=http://localhost:3000/login
NEXT_PUBLIC_REDIRECT_SIGN_OUT=http://localhost:3000/login

# GraphQL API Configuration
NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://ys3z2hpytjhxbnf4ul6eg2hvye.appsync-api.us-west-2.amazonaws.com/graphql
NEXT_PUBLIC_GRAPHQL_REGION=us-west-2
NEXT_PUBLIC_API_KEY=da2-xkws2n76mnbhnllrdbprbqglma
